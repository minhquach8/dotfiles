#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks before locating the repository.
script_file="${BASH_SOURCE[0]}"

for (( link_count=0; link_count<16; link_count++ )); do
  [[ -L "$script_file" ]] || break

  script_dir="$(cd -P "$(dirname "$script_file")" && pwd)"
  link_target="$(readlink "$script_file")"

  case "$link_target" in
    /*) script_file="$link_target" ;;
    *) script_file="$script_dir/$link_target" ;;
  esac
done

if [[ -L "$script_file" ]]; then
  echo "ERROR: Unable to resolve dothelp symlink." >&2
  exit 1
fi

repo_dir="$(cd -P "$(dirname "$script_file")/.." && pwd)"

entries=(
  "Start Here|docs/README.md"
  "User Guide|docs/user-guide.md"
  "Quick Reference|docs/quick-reference.md"
  "System Inventory|docs/inventory.md"
  "Security Policy|docs/security.md"
  "Architecture|docs/architecture-v2.md"
  "Dependencies|docs/dependencies.md"
  "Wallpaper & Displays|docs/wallpapers.md"
  "Disaster Recovery|docs/disaster-recovery.md"
  "Neovim Cheatsheet|nvim/CheatSheet.md"
  "Neovim README|nvim/README.md"
)

available=()

for entry in "${entries[@]}"; do
  relative_file="${entry#*|}"

  if [[ -f "$repo_dir/$relative_file" ]]; then
    available+=("$entry")
  fi
done

if [[ "${#available[@]}" -eq 0 ]]; then
  echo "No documentation files found."
  exit 1
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is not installed."
  echo "Available documentation:"

  printf '%s\n' "${available[@]}"
  exit 0
fi

selection="$(
  printf '%s\n' "${available[@]}" |
    fzf \
      --delimiter='|' \
      --with-nth=1 \
      --prompt='Midnight Help > ' \
      --height=75% \
      --border
)" || exit 0

[[ -n "$selection" ]] || exit 0

relative_file="${selection#*|}"
target="$repo_dir/$relative_file"

if [[ ! -f "$target" ]]; then
  echo "Document not found: $target"
  exit 1
fi

less "$target"
