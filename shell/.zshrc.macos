# Prevent duplicate PATH entries across shell initialisation.
typeset -U PATH path

# User-local commands, including dothelp and research-projects.
export PATH="$HOME/.local/bin:$PATH"

# -------------------------------------------------
# Default terminal editor
# -------------------------------------------------
export EDITOR=nvim
export VISUAL=nvim

# -------------------------------------------------
# Homebrew
# -------------------------------------------------
eval "$(/opt/homebrew/bin/brew shellenv)"

# -------------------------------------------------
# Core PATH
# -------------------------------------------------
export PATH="/Library/PostgreSQL/18/bin:$PATH"

# -------------------------------------------------
# Oh My Zsh
# -------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  web-search
)

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# -------------------------------------------------
# Starship prompt
# -------------------------------------------------
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# -------------------------------------------------
# Conda — optional, machine-independent
# -------------------------------------------------
if [[ -x "$HOME/miniconda3/bin/conda" ]]; then
  __conda_setup="$("$HOME/miniconda3/bin/conda" shell.zsh hook 2>/dev/null)"
  if [[ -n "$__conda_setup" ]]; then
    eval "$__conda_setup"
  fi
  unset __conda_setup
elif [[ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
  source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# -------------------------------------------------
# NVM
# -------------------------------------------------
export NVM_DIR="$HOME/.nvm"

if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
fi

if [ -s "$NVM_DIR/bash_completion" ]; then
  . "$NVM_DIR/bash_completion"
fi

# -------------------------------------------------
# pnpm
# -------------------------------------------------
export PNPM_HOME="$HOME/Library/pnpm"

case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# -------------------------------------------------
# fzf
# -------------------------------------------------
if [ -f "$HOME/.fzf.zsh" ]; then
  source "$HOME/.fzf.zsh"
fi

ff() {
  find . -type f | fzf
}

# -------------------------------------------------
# macOS app launcher
# -------------------------------------------------
app() {
  local chosen
  chosen=$(ls /Applications | grep '\.app$' | sed 's/\.app$//' | fzf)
  [ -n "$chosen" ] && open -a "$chosen"
}

# -------------------------------------------------
# Yazi — directory-aware file manager
# -------------------------------------------------
y() {
  local cwd_file destination="" yazi_status

  cwd_file="$(mktemp -t yazi-cwd.XXXXXX)" || return 1

  command yazi "$@" --cwd-file="$cwd_file"
  yazi_status=$?

  IFS= read -r -d '' destination < "$cwd_file" || true
  command rm -f -- "$cwd_file"

  if [[ -n "$destination" &&
        -d "$destination" &&
        "$destination" != "$PWD" ]]; then
    builtin cd -- "$destination" || return 1
  fi

  return "$yazi_status"
}

# -------------------------------------------------
# Midnight Research — Terminal Pet (optional)
# -------------------------------------------------
# Disabled by exporting TERMINAL_PET_DISABLE=1.
# The original command line is never sent to the pet.

if [[ -o interactive && "$OSTYPE" == darwin* &&
      -z "${TERMINAL_PET_DISABLE:-}" ]]; then

  terminal_pet_plugin="/opt/homebrew/opt/terminal-pet/share/terminal-pet/terminal-pet.plugin.zsh"

  if [[ -r "$terminal_pet_plugin" ]]; then
    source "$terminal_pet_plugin"

    # Replace the vendor preexec callback with a privacy-safe
    # event that does not expose the command or its arguments.
    _terminal_pet_preexec() {
      _terminal_pet_send "preexec command"
    }
  fi

  unset terminal_pet_plugin
fi
